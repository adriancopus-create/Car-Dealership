# AutoGrid configuration

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Storage – sqlite file path. Use ":memory:" for ephemeral storage
DB_PATH=./data/autogrid.db

# Scraping
# Run scrapers on server boot (true/false)
SCRAPE_ON_START=true
# Periodic scrape refresh interval (ms). 0 disables. Default 4h
SCRAPE_INTERVAL_MS=14400000
# Cache TTL before re-scraping a source (ms). Default 4h
SCRAPE_CACHE_TTL_MS=14400000
# Per-domain delay between requests (ms)
SCRAPE_REQUEST_DELAY_MS=1500
# Max listings per source per scrape
SCRAPE_MAX_PER_SOURCE=40
# Use mock fixtures instead of live scraping (recommended for local/demo)
USE_MOCK_DATA=true
# Headless browser timeout (ms)
SCRAPE_NAV_TIMEOUT_MS=30000
